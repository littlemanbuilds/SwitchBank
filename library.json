{
  "name": "SwitchBank",
  "version": "1.2.0",
  "description": "Header-only 1..32-bit switch-bank library with per-bit debounce, polarity normalization, explicit acquisition validity, coherent packed reads, freshness/change metadata, durable sequences, and Arduino GPIO helpers.",
  "keywords": "switch,switchbank,dip,debounce,input,gpio,mcp23017,expander,selector,validity,packed,edge,snapshot,arduino",
  "license": "MIT",
  "authors": [
    {
      "name": "Little Man Builds (Darren Osborne)",
      "email": "littlemanbuilds@gmail.com",
      "maintainer": true
    }
  ],
  "homepage": "https://github.com/LittleManBuilds/SwitchBank",
  "repository": {
    "type": "git",
    "url": "https://github.com/LittleManBuilds/SwitchBank.git"
  },
  "frameworks": "arduino",
  "platforms": [
    "atmelavr",
    "atmelmegaavr",
    "atmelsam",
    "espressif32",
    "espressif8266",
    "raspberrypi",
    "ststm32",
    "teensy"
  ],
  "headers": [
    "SwitchBank.h",
    "SwitchBank_Factory.h",
    "SwitchBank_Handler.h",
    "SwitchBank_Arduino.h",
    "SwitchBank_Compatibility.h"
  ],
  "build": {
    "includeDir": "src",
    "srcFilter": [
      "+<src/>"
    ]
  },
  "examples": [
    "examples/01_SimpleDIP3Bit/01_SimpleDIP3Bit.ino",
    "examples/02_ModeNames3Bit/02_ModeNames3Bit.ino",
    "examples/03_PortExpander8Bit/03_PortExpander8Bit.ino",
    "examples/04_PortExpanderCachedRead/04_PortExpanderCachedRead.ino"
  ]
}
